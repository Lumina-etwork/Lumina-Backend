{
  "title": "Configuration Management",
  "panels": [
    { "type": "stat", "title": "Config Version", "targets": [{ "expr": "config_version" }] },
    { "type": "timeseries", "title": "Reloads", "targets": [{ "expr": "rate(config_reloads_total[5m])" }] },
    { "type": "timeseries", "title": "API P99", "targets": [{ "expr": "histogram_quantile(0.99, sum(rate(api_response_time_seconds_bucket[5m])) by (le))" }] }
  ],
  "schemaVersion": 39,
  "version": 1
}
